{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "healthcare-imaging",
  "description": "Medical imaging toolkit for PACS, RIS, VNA, modalities, gateways and viewers: DICOM, DICOMweb, PS3.15 security and IHE Radiology, targeted at your declared DICOM edition.",
  "version": "1.0.1",
  "author": {
    "name": "Healthcare Copilot contributors"
  },
  "keywords": [
    "dicom",
    "dicomweb",
    "pacs",
    "ris",
    "vna",
    "ihe-radiology",
    "imaging"
  ],
  "extensions": {
    "com.github.awesome-copilot": {
      "agents": [
        "./agents/dicom-imaging-engineer.agent.md",
        "./agents/ihe-profile-advisor.agent.md",
        "./agents/healthcare-interop-architect.agent.md"
      ],
      "skills": [
        "./skills/dicom-conformance-statement",
        "./skills/dicomweb-api-design",
        "./skills/ihe-profile-mapping",
        "./skills/healthcare-version-detect",
        "./skills/phi-deidentification"
      ]
    }
  }
}
