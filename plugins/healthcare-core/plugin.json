{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "healthcare-core",
  "description": "Foundation for all healthcare work: version resolution, interoperability architecture, security/privacy review, terminology and conformance testing.",
  "version": "1.0.0",
  "author": {
    "name": "Healthcare Copilot contributors"
  },
  "keywords": [
    "healthcare",
    "interoperability",
    "versioning",
    "phi",
    "hipaa"
  ],
  "extensions": {
    "com.github.awesome-copilot": {
      "agents": [
        "./agents/healthcare-interop-architect.agent.md",
        "./agents/healthcare-security-privacy-reviewer.agent.md",
        "./agents/clinical-terminology-specialist.agent.md",
        "./agents/healthcare-conformance-tester.agent.md"
      ],
      "skills": [
        "./skills/healthcare-version-detect",
        "./skills/phi-deidentification",
        "./skills/conformance-test-plan",
        "./skills/terminology-binding"
      ],
      "hooks": [
        "./hooks/phi-scanner"
      ]
    }
  }
}
